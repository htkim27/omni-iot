# Copy this file to infra/langfuse/.env and replace every CHANGEME value.
# Generate general secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME_64_HEX_CHARACTERS
NEXTAUTH_SECRET=CHANGEME

# These fixed local keys are shared with the omni-iot root .env.
# Replace their suffixes with long random values before first startup.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_CHANGEME
LANGFUSE_INIT_USER_EMAIL=local@example.com
LANGFUSE_INIT_USER_NAME=Local Evaluator
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

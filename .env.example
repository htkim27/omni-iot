# omni-iot 환경설정 예제
# 이 파일을 `.env`로 복사한 뒤 장비와 모델 경로에 맞게 수정합니다.
# 상대 경로는 프로젝트 루트 기준이며, true/false 값은 대소문자를 구분하지 않습니다.

# -----------------------------------------------------------------------------
# OMNI 음성 이해 백엔드
# -----------------------------------------------------------------------------

# 음성 이해 모델 실행 방식입니다.
# server: 앱이 llama-server 하나를 실행해 계속 재사용하므로 일반 사용에 권장합니다.
# command: 매 대화 턴마다 OMNI_COMMAND를 별도 프로세스로 실행합니다(디버깅/대체 구현용).
OMNI_BACKEND=server

# OMNI_BACKEND=command일 때 실행할 명령입니다. server 모드에서는 사용하지 않습니다.
# 사용 가능한 자리표시자:
#   {audio}, {input}: 녹음된 입력 WAV의 절대 경로
#   {history_file}: 이전 대화 기록이 담긴 UTF-8 JSON 파일의 절대 경로
OMNI_COMMAND=uv run omni-iot-omni --audio {audio} --history-file {history_file} --json-output

# 모델의 역할과 말투를 지정하는 system prompt입니다.
OMNI_SYSTEM_PROMPT=You are a private local Korean voice assistant for a Jarvis-style IoT project. Answer naturally and concisely in Korean.

# 현재 오디오를 어떻게 처리할지 지정하는 지시문입니다. server 모드에서는 system 메시지에 포함됩니다.
OMNI_PROMPT=사용자의 음성 입력을 듣고 한국어로 자연스럽게 대답해줘.

# Brave Search MCP에서만 사용하는 API 키입니다. 실제 키는 git에서 제외된 .env에만 둡니다.
BRAVE_API_KEY=

# OMNI 한 턴이 완료될 때까지 기다릴 최대 시간(초)입니다.
OMNI_TIMEOUT_SECONDS=180

# 대화 문맥에 포함할 최근 user/assistant 메시지의 최대 개수입니다. 0이면 문맥을 사용하지 않습니다.
CONVERSATION_HISTORY_MESSAGES=12

# -----------------------------------------------------------------------------
# MCP client harness
# -----------------------------------------------------------------------------

# 로컬 MCP 서버 등록 파일입니다. 실제 파일은 git에 커밋되지 않습니다.
MCP_CONFIG=.mcp.json

# 모델에 전달할 allowlist 적용 후 OpenAI tool catalog의 최대 문자 수입니다.
MCP_TOOL_CATALOG_MAX_CHARS=12000

# MCP 도구 결과 하나를 모델에 전달할 때의 최대 문자 수입니다.
MCP_TOOL_RESULT_MAX_CHARS=12000

# Brave 웹·뉴스 검색 한 번에 반환할 최대 결과 수입니다.
# 부족하면 모델이 검색어를 바꿔 추가 검색하므로 작은 값을 권장합니다.
MCP_BRAVE_SEARCH_MAX_RESULTS=5

# 한 사용자 턴에서 허용할 최대 tool-call round와 총 call 수입니다.
MCP_MAX_TOOL_ROUNDS=4
MCP_MAX_TOOL_CALLS=8

# -----------------------------------------------------------------------------
# TTS / OmniVoice
# -----------------------------------------------------------------------------

# 텍스트를 음성으로 합성하는 방식입니다.
# omnivoice: FastAPI 프로세스에 OmniVoice를 한 번 로드해 계속 재사용합니다.
# command: 매 턴마다 TTS_COMMAND를 별도 프로세스로 실행합니다.
TTS_BACKEND=omnivoice

# TTS_BACKEND=command일 때 실행할 명령입니다. 비워두면 브라우저 음성 합성을 사용합니다.
# 사용 가능한 자리표시자:
#   {output}: 생성할 WAV 파일의 절대 경로
#   {text}: 쉘 인자 하나로 escape된 응답 문장
#   {text_file}: 응답 문장이 담긴 UTF-8 파일의 절대 경로
TTS_COMMAND=

# OmniVoice 모델 ID 또는 로컬 모델 경로입니다. 원격 ID는 최초 로딩 시 다운로드가 필요합니다.
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice

# 합성할 언어 코드입니다. 한국어는 ko를 사용합니다.
OMNIVOICE_LANGUAGE=ko

# 목소리의 성별, 억양, 음높이, 연령대 등을 지정하는 voice design 문장입니다.
OMNIVOICE_INSTRUCT=male, korean accent, moderate pitch, young adult

# 말하기 속도 배율입니다. 비워두면 모델 기본값을 사용합니다.
OMNIVOICE_SPEED=

# true이면 서버 시작 시 짧은 문장을 미리 합성해 첫 응답 지연을 줄입니다.
# 시작 시간과 초기 VRAM 사용량은 늘어납니다.
OMNIVOICE_WARMUP=true

# 음성 생성 품질을 결정하는 diffusion step 수입니다. 높을수록 느리지만 품질이 좋아질 수 있습니다.
# 허용 범위는 4~64이며 UI에서 변경한 값은 브라우저에 저장되어 이 값을 덮어씁니다.
OMNIVOICE_NUM_STEPS=32

# TTS 한 번이 완료될 때까지 기다릴 최대 시간(초)입니다.
TTS_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# 런타임 파일과 대화 기록
# -----------------------------------------------------------------------------

# `.runtime/`에 보존할 최근 턴 디렉터리 개수입니다. 초과한 오래된 턴은 자동 정리됩니다.
RUNTIME_TURN_LIMIT=20

# -----------------------------------------------------------------------------
# 호출어(openWakeWord)
# -----------------------------------------------------------------------------

# 공식 경량 "Hey Jarvis" 모델은 최초 한 번 아래 명령으로 내려받습니다.
#   uv run omni-iot-wakeword-models

# 사용할 wake-word ONNX 모델 경로입니다.
WAKEWORD_MODEL=models/openwakeword/오둥아.onnx

# 브라우저 상태 화면에 표시할 호출어 이름입니다. 실제 감지 내용은 모델이 결정합니다.
WAKEWORD_LABEL=오둥아

# 호출어로 인정할 최소 신뢰도(0 초과~1 이하)입니다.
# 낮추면 잘 인식하지만 오작동이 늘고, 높이면 오작동은 줄지만 호출을 놓칠 수 있습니다.
WAKEWORD_THRESHOLD=0.5

# openWakeWord 추론 엔진입니다. 현재 구성은 onnx를 권장하며 onnx 또는 tflite를 사용할 수 있습니다.
WAKEWORD_INFERENCE_FRAMEWORK=onnx

# AI 답변 재생 후 추가 호출어 없이 후속 질문을 기다리는 시간(밀리초)입니다.
# 호출 직후 명령을 하지 않았을 때 다시 sleep으로 돌아가는 대기 시간으로도 사용합니다.
FOLLOW_UP_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# llama.cpp / Qwen3-Omni
# RTX 5070 Ti(Blackwell sm_120)용으로 검증한 기본 설정입니다.
# -----------------------------------------------------------------------------

# 실행할 llama-server 바이너리 경로입니다.
LLAMA_SERVER=vendor/llama.cpp/build-cuda131-sm120-gcc13/bin/llama-server

# llama-server가 바인딩할 주소입니다. 127.0.0.1은 이 컴퓨터에서만 접근할 수 있습니다.
LLAMA_SERVER_HOST=127.0.0.1

# llama-server가 사용할 TCP 포트입니다.
LLAMA_SERVER_PORT=8081

# 서버 실행 후 health check가 성공할 때까지 기다릴 최대 시간(초)입니다.
LLAMA_SERVER_STARTUP_SECONDS=90

# Qwen3-Omni 본체 GGUF 모델 경로입니다.
OMNI_MODEL=models/Qwen3-Omni-30B-A3B-Instruct-Q4_K_M.gguf

# 오디오 등 멀티모달 입력을 처리하는 projector GGUF 모델 경로입니다.
OMNI_MMPROJ=models/mmproj-Qwen3-Omni-30B-A3B-Instruct-Q8_0.gguf

# GPU에 올릴 transformer layer 수입니다. 높이면 빨라지지만 VRAM 사용량이 증가합니다.
# 16GB RTX 5070 Ti에서 OmniVoice와 동시 상주할 때 20은 검증된 안전값입니다.
LLAMA_N_GPU_LAYERS=20

# 사용할 llama.cpp 장치를 명시합니다. 비워두면 자동 선택하며 보통 그대로 두는 것이 좋습니다.
LLAMA_DEVICE=

# true이면 모델의 일반 연산도 가능한 범위에서 GPU로 offload합니다.
LLAMA_OP_OFFLOAD=true

# true이면 멀티모달 projector를 GPU로 offload합니다. 속도는 빨라지고 VRAM 사용량은 늘어납니다.
LLAMA_MMPROJ_OFFLOAD=true

# 모델이 한 번에 유지할 수 있는 전체 문맥 크기(token)입니다.
# 늘리면 긴 대화에 유리하지만 KV cache 메모리 사용량이 증가합니다.
LLAMA_CTX_SIZE=4096

# 한 응답에서 새로 생성할 최대 token 수입니다. 허용 범위는 16~512입니다.
# UI에서 변경한 값은 브라우저에 저장되어 이 값을 덮어씁니다.
LLAMA_N_PREDICT=192

# 생성 무작위성입니다(0~2). 낮을수록 안정적이고 높을수록 다양한 답변이 나옵니다.
LLAMA_TEMPERATURE=0.2

# llama-server가 동시에 처리할 slot 수입니다. 현재 단일 음성 대화에는 1을 권장합니다.
LLAMA_PARALLEL=1

# CPU에서 사용하는 추론 thread 수입니다. 실제 CPU core 수에 맞춰 조절합니다.
LLAMA_THREADS=8

# true이면 이전 prompt 계산을 재사용해 연속 대화의 처리 시간을 줄입니다.
LLAMA_CACHE_PROMPT=true

# llama.cpp flash attention 설정입니다. 현재 Blackwell 빌드의 검증값은 off입니다.
LLAMA_FLASH_ATTN=off

# true이면 llama-server 시작 시 모델 warmup을 수행합니다. 시작은 느려지지만 첫 요청이 빨라질 수 있습니다.
LLAMA_WARMUP=false

# -----------------------------------------------------------------------------
# 브라우저 음성 감지(VAD)
# -----------------------------------------------------------------------------

# 음성이 시작됐다고 판단할 RMS 크기 기준값입니다(0.01~0.2).
# 낮추면 작은 목소리도 잡지만 주변 소음에 반응하기 쉬워집니다.
# UI에서 변경한 값은 브라우저에 저장되어 이 값을 덮어씁니다.
VAD_THRESHOLD=0.04

# 목소리가 사라진 후 발화 종료로 판단하기까지 기다리는 시간(밀리초, 250~2000)입니다.
# 긴 문장 중간의 쉼에서 잘린다면 1200~1500 정도로 늘립니다.
# UI에서 변경한 값은 브라우저에 저장되어 이 값을 덮어씁니다.
VAD_SILENCE_END_MS=600

# 발화 시작 직전부터 함께 보존할 오디오 길이(밀리초)입니다. 첫 음절이 잘리는 현상을 줄입니다.
VAD_PRE_ROLL_MS=450

# 사용자 발화 한 번의 최대 길이(밀리초)입니다. 이 시간을 넘으면 강제로 턴을 종료합니다.
# 긴 설명을 받으려면 예를 들어 30000(30초)으로 늘릴 수 있습니다.
VAD_MAX_TURN_MS=14000

# AI 답변 재생 중 끼어들기로 인정할 기준 배율입니다.
# 실제 기준은 VAD_THRESHOLD × 이 값이며, 높을수록 우발적인 끼어들기가 줄어듭니다.
VAD_BARGE_IN_MULTIPLIER=1.4

# 이미 시작된 발화를 계속 음성으로 인정할 기준 배율입니다.
# 실제 기준은 VAD_THRESHOLD × 이 값이며, 1보다 낮으면 말끝의 작은 목소리를 유지하기 쉽습니다.
VAD_CONTINUE_MULTIPLIER=0.72

# Optional command hooks for the browser demo.
#
# Placeholders:
#   {audio}      absolute path to recorded WAV input
#   {input}      same as {audio}
#   {output}     absolute path where TTS should write a WAV file
#   {text}       OMNI text response, shell-escaped as a single argument
#   {text_file}  UTF-8 file containing the OMNI response text
#
# If unset, the demo uses a mock OMNI response and browser-side speech synthesis.

# server: start one managed llama-server process with the app and reuse it
# command: run OMNI_COMMAND as a subprocess for each turn (fallback/debugging)
OMNI_BACKEND=server
OMNI_COMMAND=uv run omni-iot-omni --audio {audio} --history-file {history_file} --json-output

# TTS_BACKEND can be:
#   omnivoice  load k2-fsa/OmniVoice inside the FastAPI server and reuse it
#   command    run TTS_COMMAND as a subprocess for each turn
TTS_BACKEND=omnivoice
TTS_COMMAND=

OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_LANGUAGE=ko
OMNIVOICE_INSTRUCT=male, korean accent, moderate pitch, young adult
OMNIVOICE_SPEED=
OMNIVOICE_WARMUP=true

OMNI_TIMEOUT_SECONDS=180
TTS_TIMEOUT_SECONDS=180
RUNTIME_TURN_LIMIT=20
CONVERSATION_HISTORY_MESSAGES=12

# Managed llama-server settings verified on RTX 5070 Ti (Blackwell sm_120).
LLAMA_SERVER=vendor/llama.cpp/build-cuda131-sm120-gcc13/bin/llama-server
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081
LLAMA_SERVER_STARTUP_SECONDS=90
OMNI_MODEL=models/Qwen3-Omni-30B-A3B-Instruct-Q4_K_M.gguf
OMNI_MMPROJ=models/mmproj-Qwen3-Omni-30B-A3B-Instruct-Q8_0.gguf
LLAMA_N_GPU_LAYERS=20
LLAMA_DEVICE=
LLAMA_OP_OFFLOAD=true
LLAMA_MMPROJ_OFFLOAD=true
LLAMA_CTX_SIZE=4096
LLAMA_N_PREDICT=192
LLAMA_FLASH_ATTN=off
LLAMA_WARMUP=false
OMNIVOICE_CLEAR_BEFORE_OMNI=true
